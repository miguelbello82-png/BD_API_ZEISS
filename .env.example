# ==========================================
# BD_API_ZEISS — Configuração de Ambiente (.env.example)
# ==========================================

# ------------------------------------------
# ZEISS API Endpoints & Credentials
# ------------------------------------------
ZEISS_ORDERS_BASE_URL=https://<api-orders-endpoint>.amazonaws.com
ZEISS_TRACKING_BASE_URL=https://<api-tracking-endpoint>.amazonaws.com
ZEISS_CAMPAIGNS_BASE_URL=https://<api-campaigns-endpoint>.amazonaws.com
ZEISS_FINANCIAL_BASE_URL=https://<api-financial-endpoint>.amazonaws.com
ZEISS_SERVICES_BASE_URL=https://<api-services-endpoint>.amazonaws.com
ZEISS_API_KEY=<sua_zeiss_api_key>
ZEISS_COUNTRY_ID=1
ZEISS_CNPJ=<cnpj_sem_pontuacao>
ZEISS_STORE_ID=<id_loja>
ZEISS_SAOWEB_CODE=<codigo_saoweb>
ZEISS_VOUCHER_USER_ID=<id_usuario_voucher>
ZEISS_FIN_USER_ID=0

# ------------------------------------------
# PostgreSQL / Supabase Worker Connection
# ------------------------------------------
# Role dedicada do worker: bd_api_zeiss_worker
# Endpoint direto (IPv6): db.<project-ref>.supabase.co:5432/postgres
# Endpoint pooler (IPv4): aws-0-<region>.pooler.supabase.com:5432/postgres (usuário: bd_api_zeiss_worker.<project-ref>)
#
# IMPORTANTE: A senha deve ter seus caracteres reservados codificados via URL percent-encoding (ex.: encodeURIComponent(senha))
# IMPORTANTE TLS: Utilize sslmode=verify-full e aponte sslrootcert para o certificado raiz da Supabase (prod-ca-2021.crt),
# ou configure a variável de ambiente NODE_EXTRA_CA_CERTS antes da inicialização do Node.js.
#
DATABASE_URL=postgresql://bd_api_zeiss_worker:<SUA_SENHA_CODIFICADA>@db.<project-ref>.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=config/prod-ca-2021.crt

# Certificado CA adicional para TLS do Node.js (se configurado via shell antes do boot do Node)
# NODE_EXTRA_CA_CERTS=C:\caminho\para\prod-ca-2021.crt
